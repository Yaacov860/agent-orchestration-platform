# Copy to .env for local runs outside Docker. Never commit .env.
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5433/orchestrator
# "gemini" (default) or "none". Without a key the API still runs; tasks fail with a clear error.
LLM_PROVIDER=gemini
# Personal Google AI Studio key. Keep it in .env only (git-ignored); it is never logged.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=60

# Limits (defaults shown; see README). Out-of-range values stop the app at startup.
# MAX_CONCURRENT_PLANS=4
# MAX_CONCURRENT_STEPS=4
# STEP_TIMEOUT_SECONDS=180
# STEP_MAX_ATTEMPTS=3
# STEP_RETRY_BASE_DELAY_SECONDS=1
# MAX_CONTEXT_CHARS_PER_INPUT=8000
# MAX_CONCURRENT_SYNTHESES=4
# SYNTHESIS_TIMEOUT_SECONDS=120
