# Copy to .env. Local runs read all of it; `docker compose` reads it for the settings it forwards
# (inside Docker, DATABASE_URL is set by docker-compose.yml). Never commit .env.
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5433/orchestrator
# "gemini" (default) or "none". Without a key the API still runs; tasks fail with a clear error.
LLM_PROVIDER=gemini
# Personal Google AI Studio key. Keep it in .env only (git-ignored); it is never logged.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=60
# Tried in order when a model is overloaded or out of quota; set it empty for no fallback.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Google Search grounding for research steps: true by default in the app, false by default in
# docker compose. Needs Google Search quota on the key.
# GEMINI_SEARCH_GROUNDING=false

# Limits (defaults shown; see README). Out-of-range values stop the app at startup.
# MAX_CONCURRENT_PLANS=4
# MAX_CONCURRENT_STEPS=4
# STEP_TIMEOUT_SECONDS=180
# STEP_MAX_ATTEMPTS=3
# STEP_RETRY_BASE_DELAY_SECONDS=1
# MAX_CONTEXT_CHARS_PER_INPUT=8000
# MAX_CONCURRENT_SYNTHESES=4
# SYNTHESIS_TIMEOUT_SECONDS=120
